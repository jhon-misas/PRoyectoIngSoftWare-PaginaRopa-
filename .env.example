# Copia este archivo con el nombre .env (en la misma carpeta) y llena los valores.
# El .env NUNCA se sube a GitHub.

# Cadena de conexión de PostgreSQL (Neon: botón Connect). Ejemplo:
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Texto largo y secreto para firmar las sesiones (cualquier texto de 32+ caracteres)
JWT_SECRET=

# Cloudinary (Dashboard -> API Keys). Necesario para subir fotos desde el panel.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Inicio de sesión con Google (Google Cloud Console -> Credentials -> OAuth client ID).
# Es el "Client ID", termina en .apps.googleusercontent.com. Si se deja vacío, el botón de Google no aparece.
GOOGLE_CLIENT_ID=

# Pasarela de pagos Wompi, ambiente de PRUEBAS (comercios.wompi.co -> Desarrolladores).
# Llave pública (empieza por pub_test_) y secreto de integridad (empieza por test_integrity_).
# Si se dejan vacíos, solo funciona "Contra entrega".
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
# Opcional. Por defecto https://sandbox.wompi.co/v1 (pruebas). NO cambiar para la entrega.
# WOMPI_API_URL=

# Opcional. Si se deja vacío, la API usa el puerto 3000. NO usar 5173 (es el de React).
PORT=

# Solo para las pruebas automáticas (npm test)
# BASE_URL=https://wut-force-armour.onrender.com
TEST_ADMIN_CORREO=
TEST_ADMIN_CONTRASENA=
